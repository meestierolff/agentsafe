<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The sandbox is what makes "it cannot phone home" a fact instead of a promise. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Read and write only what the user picks in a system file dialog. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Remember that choice between launches. -->
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- Deliberately absent: com.apple.security.network.client and .server.
         Without them macOS blocks every connection this app tries to make. -->
</dict>
</plist>
